+++ b/src/App.tsx
@@ -1068,6 +1068,8 @@ export default function App() {
                       isPlaying={isPlaying}
                       isLooping={isLooping}
                       canUndo={canUndo}
+                      onPlayPause={handlePlayPause}
+                      onStop={handleStop}
                       onSeek={handleSeek}
                       onPreviewStart={handlePreviewStart}
