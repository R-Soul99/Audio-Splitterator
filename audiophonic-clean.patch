+    const processedBuffer =
+      effectiveSampleRate !== rawProcessed.sampleRate
+        ? await resampleAudioBuffer(rawProcessed, effectiveSampleRate)
+        : rawProcessed;
+
+    // 4. Metadata tags from filename
